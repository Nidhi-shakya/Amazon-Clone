# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Leave empty or set to mongodb://localhost:27017/shopzone
# If local MongoDB is not running, the server automatically starts an in-memory MongoDB!
MONGODB_URI=mongodb://localhost:27017/shopzone

# JWT Secret Key for Authentication
JWT_SECRET=shopzone_super_secret_jwt_key_2026_dev_secure

# Client URL for CORS
CLIENT_URL=http://localhost:5173

